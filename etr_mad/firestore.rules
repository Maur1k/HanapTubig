rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Public users can view station records, but nobody can mutate them
    // until an authenticated, explicitly authorized editor workflow exists.
    match /refill_stations/{stationId} {
      allow read: if true;
      allow create, update, delete: if false;
    }

    // Deny access to every other collection by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
